# Current target: SQLite (zero-setup)
DATABASE_URL=sqlite+aiosqlite:///./crm.db
TEST_DATABASE_URL=sqlite+aiosqlite:///./crm_test.db

# Future PostgreSQL migration (config-only change):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/crm_dev
# TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/crm_test

# JWT Authentication
# IMPORTANT: Replace with a strong random secret (min 32 chars) in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme-replace-with-a-secure-random-key-min-32-chars
JWT_EXPIRE_MINUTES=60
